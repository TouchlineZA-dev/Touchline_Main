# Base path for the Touchline data API (Netlify functions).
# Leave as-is for local dev and production; the redirects in netlify.toml
# map /api/v1/* onto the functions.
VITE_API_BASE_URL=/api/v1

# ---------------------------------------------------------------------------
# Server-side only — do NOT add these here with a VITE_ prefix.
#
# The Netlify functions read Supabase credentials from the environment at
# runtime. Anything prefixed VITE_ is inlined into the browser bundle, so
# database credentials must never be named that way.
#
# Set these in the Netlify UI (Site settings -> Environment variables), or in a
# root-level .env when running `netlify dev`:
#
#   SUPABASE_URL=
#   SUPABASE_SERVICE_ROLE_KEY=
# ---------------------------------------------------------------------------
