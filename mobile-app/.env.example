# Touchline Mobile App Environment Configuration
# Public client configuration only - NEVER add service role keys, DB passwords, or secrets here.

# Touchline API (ASP.NET Core). Leave unset in local dev: defaults to http://localhost:5147/api/v1
# (http://10.0.2.2:5147/api/v1 on the Android emulator). On a physical device use your machine's
# LAN IP, and run the API bound to it (e.g. dotnet run --urls http://0.0.0.0:5147).
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5147/api/v1

# Touchline News API (touchline-news-api). Defaults to http://localhost:3000/api.
# EXPO_PUBLIC_NEWS_API_BASE_URL=http://192.168.1.10:3000/api

