# Server-side configuration for the local dev API (frontend/scripts/dev-api.mjs).
# Copy to .env and fill in. Gitignored — never commit the real file.
#
# These are the same variables Netlify holds; nothing here is a VITE_ variable,
# because none of it may reach the browser.
#
#   cd frontend && node --env-file=../.env scripts/dev-api.mjs

# Supabase project origin — no trailing slash, no /rest/v1 suffix.
SUPABASE_URL=https://exyzbdbitrsidompguda.supabase.co

# Supabase -> Settings -> API -> secret key (sb_secret_...), used by the
# football endpoints via PostgREST.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection used by the news endpoint, which reads
# sync.news_cache. Connect as app_api_user on port 6543 (transaction pooler).
# Password comes from the password manager — see BACKEND_INTEGRATION.md §2.
DATABASE_URL=postgresql://app_api_user.exyzbdbitrsidompguda:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Sportmonks API key, used only by scripts/fetch-stat-types.mjs to resolve
# stat type ids to their real names. Copy from Netlify env.
SPORTMONKS_API_KEY=
